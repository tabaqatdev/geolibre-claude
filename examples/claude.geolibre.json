{
  "version": "0.1",
  "view": {
    "bounds": [-180, -60, 180, 80]
  },
  "layers": [
    {
      "id": "big-cities",
      "name": "Cities over 5M",
      "source": {
        "type": "arcgis",
        "layer": "https://sampleserver6.arcgisonline.com/arcgis/rest/services/SampleWorldCities/MapServer/0",
        "where": "POP > 5000000"
      },
      "style": {
        "type": "graduated",
        "field": "POP",
        "opacity": 0.85,
        "classes": [
          { "min": 5000000, "max": 7000000, "color": "#fee5d9" },
          { "min": 7000000, "max": 9000000, "color": "#fcae91" },
          { "min": 9000000, "max": 12000000, "color": "#fb6a4a" },
          { "min": 12000000, "max": null, "color": "#cb181d" }
        ]
      },
      "visible": true
    }
  ]
}
