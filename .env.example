# ─────────────────────────────────────────────────────────────────────────────
# GeoLibre-Claude — configuration
# Copy to `.env` (git-ignored) and adjust. `start.sh` / `start.ps1` read this.
# ─────────────────────────────────────────────────────────────────────────────

# Data catalog the DATA tools read from. Endpoint-agnostic — point at any
# ArcGIS-REST services root (yours, or a public one).
GEOLIBRE_CATALOG_URL=https://example.com/arcgis/rest/services

# ── Transport ────────────────────────────────────────────────────────────────
# stdio : zero-config; the MCP client (Claude Desktop/Code) spawns the binary.
# http  : durable Streamable-HTTP + OAuth for Claude Desktop at team scale.
#         Claude's HTTP connector REQUIRES https, so this path needs TLS certs.
GEOLIBRE_CLAUDE_TRANSPORT=stdio

# ── HTTPS server (only used when TRANSPORT=http) ─────────────────────────────
GEOLIBRE_CLAUDE_HTTP_HOST=127.0.0.1
GEOLIBRE_CLAUDE_HTTP_PORT=8443
# mkcert-generated, locally-trusted cert/key. `start.sh` creates these for you.
GEOLIBRE_CLAUDE_TLS_CERT=certs/localhost.pem
GEOLIBRE_CLAUDE_TLS_KEY=certs/localhost-key.pem

# ── Auth (only used when TRANSPORT=http; MCP acts as OAuth Resource Server) ───
# Static bearer token that /mcp requires. Simplest way to protect + test the HTTP
# endpoint without an IdP. Generate one with:  openssl rand -hex 32
GEOLIBRE_CLAUDE_AUTH_TOKEN=
# For a real IdP: the issuer is advertised in the RFC 9728 discovery document so
# Claude can find your authorization server. (JWT/JWKS validation is a future add-on;
# today the bearer token above is what's enforced.)
GEOLIBRE_CLAUDE_OAUTH_ISSUER=
GEOLIBRE_CLAUDE_OAUTH_AUDIENCE=geolibre-claude
GEOLIBRE_CLAUDE_OAUTH_JWKS_URL=

# ── Languages ────────────────────────────────────────────────────────────────
# Mirrors GeoLibre's 16 supported locales; missing keys fall back to `en`.
GEOLIBRE_CLAUDE_DEFAULT_LOCALE=en
GEOLIBRE_CLAUDE_LOCALES=en,zh,es,fr,de,pt,it,nl,ja,ko,ru,tr,id,hi,th,ar

# ── Live app control ─────────────────────────────────────────────────────────
# Where `start.sh` installs the GeoLibre plugin drop-in so the app discovers it.
GEOLIBRE_PLUGINS_DIR=~/.geolibre/plugins

# Base directory for project files (also settable with the --root flag).
GEOLIBRE_CLAUDE_ROOT=~/maps

# ── GeoParquet sources (optional; enables the GeoParquet backend) ─────────────
# describe_layer / query_data accept a `*.parquet` layer reference when one of
# these is set. Local files must resolve UNDER the root; remote files must start
# with the prefix. Everything else is refused.
GEOLIBRE_PARQUET_ROOT=
GEOLIBRE_PARQUET_URL_PREFIX=
